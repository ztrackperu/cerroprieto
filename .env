# =============================================================================
# Cerro Prieto — variables para Docker (desarrollo y staging)
# =============================================================================
# Copia a .env:  cp .env.example .env
#
# Docker Compose lee este archivo para sustituir ${VAR} en docker-compose*.yml
# y esas mismas variables llegan al contenedor web → Config.php modo "env".

# -----------------------------------------------------------------------------
# Desarrollo (docker compose up)
# -----------------------------------------------------------------------------
# Deja comentado o vacío lo que quieras por defecto (MySQL interno, sin APIs).
# Para probar con APIs reales, descomenta y rellena URLAPI_*.

WEB_PORT=8080
MYSQL_PORT=3306

# BASE_URL=http://localhost:8080/

# APIs (opcional en dev; sin URLAPI_MYSQL el login usa BD local admin/admin)
URLAPI=http://161.132.206.104:8000
URLAPI_MYSQL=http://161.132.206.104:9010
URLAPI_MONGO=http://161.132.206.104:9020
URLAPI_MONGO2=http://161.132.206.104:9050
# Series Cerro Prieto (TermoKing) — típicamente 9051
URL_NUEVA=http://161.132.53.51:9051
CERRO_PRIETO_SERIES_IMEI=860389053949943

# -----------------------------------------------------------------------------
# Staging / prueba (docker compose -f docker-compose.staging.yml up -d)
# -----------------------------------------------------------------------------
# Rellena TODO lo siguiente con los mismos criterios que producción (Config.php).
# DB_HOST: MySQL accesible desde el contenedor, p. ej. host.docker.internal o IP.

# Docker: con docker-compose.yml o docker-compose.staging.yml el servicio MySQL se llama "mysql".
# NO uses host.docker.internal aquí salvo que sepas que MySQL admite tu usuario desde red Docker.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=zgroupztrack
DB_USER=ztrack2023
DB_PASS=lpmp2018
DB_CHARSET=utf8mb4
BASE_URL=http://localhost:8080/
MYSQL_ROOT_PASSWORD=rootstaging
MYSQL_STAGING_PORT=3307

