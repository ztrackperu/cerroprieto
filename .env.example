# ===========================================
# Cerro Prieto - Variables de entorno (ejemplo)
# ===========================================
# Copia a .env y ajusta los valores:
#   cp .env.example .env

# --- Base de datos ---
# En Docker, el servicio mysql usa estas credenciales por defecto.
# Solo descomenta si quieres sobrescribir.
# DB_HOST=mysql
# DB_PORT=3306
# DB_NAME=zgroupot
# DB_USER=cerroprieto
# DB_PASS=cerroprieto

# --- URL de la aplicación ---
# BASE_URL=http://localhost:8080/

# --- APIs externas (requeridas para login vía API) ---
# Sin estas URLs, el login usa la BD local (admin/admin).
URLAPI=
URLAPI_MYSQL=
URLAPI_MONGO=
URLAPI_MONGO2=
URL_NUEVA=
