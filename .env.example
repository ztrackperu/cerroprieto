# =============================================================================
# Cerro Prieto — variables para Docker Compose y (opcional) lectura por Config.php
# =============================================================================
# Copia a .env:  cp .env.example .env
#
# Docker Compose sustituye ${VAR} en docker-compose*.yml.
# Config.php también puede leer este archivo al inicio (sin pisar variables que ya
# definió el sistema o el contenedor). Ver README "Configuración".
#
# ERROR SQLSTATE[HY000] [1045] Access denied: casi siempre DB_PASS incorrecto o
# usuario MySQL sin permiso desde la red Docker (p. ej. solo 'user'@'localhost').
# Usa la MISMA contraseña que en el bloque else de Config.php o la que tenga MySQL.

# -----------------------------------------------------------------------------
# Puertos (docker compose up — stack con MySQL en contenedor)
# -----------------------------------------------------------------------------
WEB_PORT=8080
MYSQL_PORT=3306

# -----------------------------------------------------------------------------
# Staging: web + MySQL en Docker (docker compose -f docker-compose.staging.yml up -d)
# En el servicio web, DB_HOST queda fijado a "mysql" en el compose (no uses
# host.docker.internal salvo que montes otro compose a medida).
# -----------------------------------------------------------------------------
# DB_NAME=zgroupztrack
# DB_USER=ztrack2023
# DB_PASS=tu_contraseña
# DB_CHARSET=utf8mb4
# BASE_URL=http://localhost:8080/
# MYSQL_ROOT_PASSWORD=rootstaging
# MYSQL_STAGING_PORT=3307

# -----------------------------------------------------------------------------
# PHP directo (Apache en el servidor, sin Docker): dos opciones
# -----------------------------------------------------------------------------
# A) No definas DB_HOST en este archivo (ni en php-fpm): se usa el bloque else de
#    Config.php (host, user, pass editados a mano en Config/Config.php).
# B) O define aquí (mismos valores que el bloque else):
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=zgroupztrack
# DB_USER=ztrack2023
# DB_PASS=pon_la_contraseña_real
# DB_CHARSET=utf8mb4
# BASE_URL=https://tudominio.com/cerroprieto/

# -----------------------------------------------------------------------------
# APIs (opcional)
# -----------------------------------------------------------------------------
# URLAPI=http://161.132.206.104:8000
# URLAPI_MYSQL=http://161.132.206.104:9010
# URLAPI_MONGO=http://161.132.206.104:9020
# URLAPI_MONGO2=http://161.132.206.104:9050
# URL_NUEVA=http://161.132.53.51:9051
# CERRO_PRIETO_SERIES_IMEI=860389053949943
